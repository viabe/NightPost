<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 기존 배경 크기와 표시 방식을 유지함 -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_background_night" />

    <!-- 아이콘과 문구를 중앙 영역보다 조금 위에 배치함 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <!-- 대기·배달 중·도착 아이콘을 표시함 -->
        <ImageView
            android:id="@+id/widget_state_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_icon_waiting" />

        <!-- 현재 배달 상태를 표시함 -->
        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="배달 대기"
            android:textColor="#FFF0C2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#E60A1630"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3.5" />

        <!-- 현재 상태에 해당하는 편지 수를 표시함 -->
        <TextView
            android:id="@+id/widget_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="준비된 편지 0통"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#E60A1630"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3.0" />

    </LinearLayout>

</FrameLayout>
